{"content": {"exact_text": "we will follow the unidirectional way to support both traffic understanding and generation tasks, which makes it necessary to handle the cost of relatively insufficient modeling of token associations", "field": "traffic.author_stated_limitations", "negative_state": null, "numeric": null}, "created_at": "2026-09-02T21:24:46.889574Z", "decisions": [], "evidence_type": "limitation", "id": "E0022", "origin": "author_claimed", "provenance": {"actor": "scripted/scripted-1", "note": null, "run_id": "run_20260902T212444Z_547df086", "source": "model", "template_version": "1.0.0", "workflow": "interrogate"}, "qualification": null, "review_tier": 2, "schema_version": 1, "source": {"artifact": "A0002-1", "bbox": {"x0": 53.8, "x1": 295.73, "y0": 349.11, "y1": 610.21}, "block": "B0031", "char_end": 845, "char_start": 646, "file_hash": "sha256:7fd0b8285aedef74df285a63270a5637292d03bb283fcbaaf7b3a3491ed7d224", "page": 2, "section_path": ["1 INTRODUCTION"], "text_hash": "sha256:62e456b7610e7fc0dc70dcc635f0e981dbff083a9e2101e1b8200079119498f7", "version": "V0002-1", "work": "W0002"}, "stale": "fresh", "strength": "direct", "updated_at": "2026-09-02T21:38:52.922854Z", "verification": {"accepted_by": "human", "extractor": "scripted/scripted-1", "rationale": "The authors state the cost of their unidirectional design.", "review_action": "accept", "reviewed_at": "2026-09-02T21:38:52.922838Z", "status": "accepted", "verdict": "supported", "verifier": "scripted/scripted-1"}}
