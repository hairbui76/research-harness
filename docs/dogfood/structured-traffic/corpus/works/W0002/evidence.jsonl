{"content": {"exact_text": "we translate each byte into its corresponding hex number, and then use a tokenizer to generate tokens", "field": "traffic.representation_family", "negative_state": null, "numeric": null}, "created_at": "2026-09-02T21:24:46.521204Z", "decisions": [], "evidence_type": "representation_description", "id": "E0007", "origin": "author_claimed", "provenance": {"actor": "scripted/scripted-1", "note": null, "run_id": "run_20260902T212444Z_547df086", "source": "model", "template_version": "1.0.0", "workflow": "interrogate"}, "qualification": null, "review_tier": 2, "schema_version": 1, "source": {"artifact": "A0002-1", "bbox": {"x0": 53.8, "x1": 295.72, "y0": 301.29, "y1": 442.83}, "block": "B0068", "char_end": 190, "char_start": 89, "file_hash": "sha256:7fd0b8285aedef74df285a63270a5637292d03bb283fcbaaf7b3a3491ed7d224", "page": 4, "section_path": ["3 NETGPT", "3.1 Pretraining"], "text_hash": "sha256:0634db070cc5cfed2d41b0d85eb2f4f9a2a22daaa0c8e8237351689ecfa8bacb", "version": "V0002-1", "work": "W0002"}, "stale": "fresh", "strength": "direct", "updated_at": "2026-09-02T21:37:29.034242Z", "verification": {"accepted_by": "human", "extractor": "scripted/scripted-1", "rationale": "The span describes byte-level serialisation of raw traffic.", "review_action": "accept", "reviewed_at": "2026-09-02T21:37:29.034224Z", "status": "accepted", "verdict": "supported", "verifier": "scripted/scripted-1"}}
{"content": {"exact_text": "Shuffling Header Fields. To cater to adapt to generation tasks, we use GPT models as our basic model.", "field": "traffic.representation_family", "negative_state": null, "numeric": null}, "created_at": "2026-09-02T21:24:46.524958Z", "decisions": [], "evidence_type": "representation_description", "id": "E0008", "origin": "author_claimed", "provenance": {"actor": "scripted/scripted-1", "note": null, "run_id": "run_20260902T212444Z_547df086", "source": "model", "template_version": "1.0.0", "workflow": "interrogate"}, "qualification": "the span is a subsection heading plus a sentence about the base model; it evidences that header fields are handled separately, not the representation family as a whole", "review_tier": 2, "schema_version": 1, "source": {"artifact": "A0002-1", "bbox": {"x0": 317.56, "x1": 559.89, "y0": 274.16, "y1": 391.69}, "block": "B0081", "char_end": 101, "char_start": 0, "file_hash": "sha256:7fd0b8285aedef74df285a63270a5637292d03bb283fcbaaf7b3a3491ed7d224", "page": 4, "section_path": ["3 NETGPT", "3.2 Finetuning"], "text_hash": "sha256:add1add1a55a8a0dcb88a9d6d774eb5fc452898e8b7c79b10aac8b715db36394", "version": "V0002-1", "work": "W0002"}, "stale": "fresh", "strength": "direct", "updated_at": "2026-09-02T21:37:33.997598Z", "verification": {"accepted_by": "human", "extractor": "scripted/scripted-1", "rationale": "The span shows header fields are handled as separable units but says nothing about the input representation family as such.", "review_action": "accept_with_qualification", "reviewed_at": "2026-09-02T21:37:33.997580Z", "status": "accepted", "verdict": "partially_supported", "verifier": "scripted/scripted-1"}}
{"content": {"exact_text": "With diverse traffic datasets from encrypted software, DNS, private industrial protocols and cryptocurrency mining", "field": "traffic.encryption_status", "negative_state": null, "numeric": null}, "created_at": "2026-09-02T21:24:46.763098Z", "decisions": [], "evidence_type": "dataset_description", "id": "E0020", "origin": "author_claimed", "provenance": {"actor": "scripted/scripted-1", "note": null, "run_id": "run_20260902T212444Z_547df086", "source": "model", "template_version": "1.0.0", "workflow": "interrogate"}, "qualification": null, "review_tier": 2, "schema_version": 1, "source": {"artifact": "A0002-1", "bbox": {"x0": 53.8, "x1": 295.73, "y0": 451.99, "y1": 629.25}, "block": "B0023", "char_end": 628, "char_start": 514, "file_hash": "sha256:7fd0b8285aedef74df285a63270a5637292d03bb283fcbaaf7b3a3491ed7d224", "page": 1, "section_path": ["arXiv:2304.09513v3 [cs.NI] 28 Aug 2025"], "text_hash": "sha256:7cdae2c556b864bce3af283eb52f4cff664c50099969573861825029f7f02d56", "version": "V0002-1", "work": "W0002"}, "stale": "fresh", "strength": "direct", "updated_at": "2026-09-02T21:38:42.444501Z", "verification": {"accepted_by": "human", "extractor": "scripted/scripted-1", "rationale": "The span establishes a mixed-encryption corpus.", "review_action": "accept", "reviewed_at": "2026-09-02T21:38:42.444483Z", "status": "accepted", "verdict": "supported", "verifier": "scripted/scripted-1"}}
