<div
  data-density="comfortable"
  data-theme="dark"
>
  <article
    class="rh-card rh-card--raised rh-card--pad-md rh-evidence-card"
    data-authority="accepted"
    data-evidence-id="E0482"
  >
    <div
      class="rh-card__header"
    >
      <span
        class="rh-evidence-card__title"
      >
        <svg
          aria-hidden="true"
          class="lucide lucide-quote rh-icon"
          data-icon="quote"
          fill="none"
          focusable="false"
          height="16"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="16"
          xmlns="http://www.w3.org/2000/svg"
