        <span
          class="rh-evidence-card__id"
        >
          E0482
        </span>
        <span
          class="rh-evidence-card__work"
        >
          Hydrogel stiffness and neurite outgrowth (2024)
        </span>
      </span>
      <span
        class="rh-evidence-card__badges"
      >
        <span
          class="rh-badge rh-badge--sm rh-badge--status-accepted rh-authority-badge"
          data-authority="accepted"
          data-status="accepted"
        >
          <svg
            aria-hidden="true"
            class="lucide lucide-circle-check rh-icon"
            data-icon="circle-check"
            fill="none"
            focusable="false"
