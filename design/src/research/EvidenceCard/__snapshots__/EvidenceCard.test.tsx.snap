            width="14"
            xmlns="http://www.w3.org/2000/svg"
          >
            <circle
              cx="12"
              cy="12"
              r="10"
            />
            <path
              d="m16 9-5.5 5.5L8 12"
            />
          </svg>
          <span
            class="rh-badge__label"
          >
            Accepted
          </span>
        </span>
      </span>
    </div>
    <div
      class="rh-card__body"
    >
      <blockquote
        class="rh-evidence-card__quote"
      >
        Storage modulus rose from 1.2 to 8.4 kPa over 24 h, with no measurable change in swelling ratio.
      </blockquote>
      <p
        class="rh-evidence-card__numeric"
      >
        <span
          class="rh-evidence-card__numeric-value"
        >
          8.4
           kPa
        </span>
        <span
          class="rh-evidence-card__numeric-meta"
        >
          storage modulus
        </span>
        <span
          class="rh-evidence-card__numeric-meta"
        >
          24 h timepoint
        </span>
      </p>
      <dl
        class="rh-evidence-card__facts"
      >
        <div
          class="rh-evidence-card__fact"
        >
          <dt
            class="rh-text-label"
          >
            Work
          </dt>
          <dd
            class="rh-evidence-card__fact-value"
          >
            W0017
          </dd>
        </div>
