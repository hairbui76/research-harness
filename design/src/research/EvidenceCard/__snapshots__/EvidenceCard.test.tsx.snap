          >
            measurement
          </dd>
        </div>
        <div
          class="rh-evidence-card__fact"
        >
          <dt
            class="rh-text-label"
          >
            Strength
          </dt>
          <dd
            class="rh-evidence-card__fact-value"
          >
            direct
          </dd>
        </div>
        <div
          class="rh-evidence-card__fact"
        >
          <dt
            class="rh-text-label"
          >
            Origin
          </dt>
          <dd
            class="rh-evidence-card__fact-value"
          >
            researcher
          </dd>
        </div>
        <div
          class="rh-evidence-card__fact"
        >
          <dt
            class="rh-text-label"
          >
            Field
          </dt>
          <dd
            class="rh-evidence-card__fact-value"
          >
            materials
          </dd>
        </div>
      </dl>
    </div>
    <div
