            >
              <path
                d="M12 3v18"
              />
              <path
                d="m19 8 3 8a5 5 0 0 1-6 0zV7"
              />
              <path
                d="M3 7h1a17 17 0 0 0 8-2 17 17 0 0 0 8 2h1"
              />
              <path
                d="m5 8 3 8a5 5 0 0 1-6 0zV7"
              />
              <path
                d="M7 21h10"
              />
            </svg>
            <span
              class="rh-entity-ref__id"
            >
              C0041
            </span>
            <span
              class="rh-entity-ref__label"
            >
              Stiffer gels shorten neurites
            </span>
            <span
              class="rh-badge rh-badge--sm rh-badge--status-qualified rh-authority-badge rh-entity-ref__authority"
              data-authority="qualified"
