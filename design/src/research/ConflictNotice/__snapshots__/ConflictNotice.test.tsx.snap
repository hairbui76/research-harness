          />
        </svg>
        <span
          class="rh-badge__label"
        >
          Contested
        </span>
      </span>
    </div>
    <div
      class="rh-card__body"
    >
      <p
        class="rh-conflict-notice__explanation"
      >
        A message in this session contradicts an accepted claim. The accepted claim was sent to the model; the message was not.
      </p>
      <div
        class="rh-conflict-notice__sides"
      >
        <div
          class="rh-conflict-notice__side"
          data-side="accepted"
        >
          <p
            class="rh-conflict-notice__side-label"
          >
            <svg
              aria-hidden="true"
              class="lucide lucide-circle-check rh-icon"
              data-icon="circle-check"
              fill="none"
              focusable="false"
              height="14"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              width="14"
