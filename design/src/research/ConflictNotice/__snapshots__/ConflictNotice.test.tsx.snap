                />
                <path
                  d="M12 16v-4"
                />
                <path
                  d="M12 8h.01"
                />
              </svg>
              <span
                class="rh-badge__label"
              >
                Qualified
              </span>
            </span>
          </span>
          <blockquote
            class="rh-conflict-notice__excerpt"
          >
            The reviewed threshold is 5 kPa, qualified to 3D cultures.
          </blockquote>
        </div>
        <div
          class="rh-conflict-notice__side"
          data-side="chat"
        >
