          >
            <circle
              cx="12"
              cy="12"
              r="10"
            />
            <path
              d="M12 16v-4"
            />
            <path
              d="M12 8h.01"
            />
          </svg>
          <span
            class="rh-button__label"
          >
            Qualify
          </span>
        </span>
      </button>
      <button
        aria-describedby="rh-review-decision-ID-edit"
        class="rh-button rh-button--secondary rh-button--sm"
        data-decision="edit"
        data-variant="secondary"
        type="button"
      >
        <span
          class="rh-button__content"
        >
          <svg
            aria-hidden="true"
            class="lucide lucide-pen-line rh-icon"
            data-icon="pen-line"
            fill="none"
            focusable="false"
            height="14"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="14"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M13 21h8"
            />
            <path
              d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"
            />
          </svg>
          <span
            class="rh-button__label"
          >
            Edit
          </span>
        </span>
      </button>
      <button
        aria-describedby="rh-review-decision-rp-ID"
        class="rh-button rh-button--secondary rh-button--sm"
