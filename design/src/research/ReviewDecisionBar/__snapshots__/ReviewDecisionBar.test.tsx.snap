exports[`ReviewDecisionBar theme x density > matches the dark / comfortable snapshot 1`] = `
<div
  data-density="comfortable"
  data-theme="dark"
>
  <div
    aria-label="Review decision"
    class="rh-review-decision-bar"
    role="group"
  >
    <div
      class="rh-review-decision-bar__buttons"
    >
      <button
        aria-describedby="rh-review-decision-ID-accept"
        class="rh-button rh-button--primary rh-button--sm"
        data-decision="accept"
        data-variant="primary"
        type="button"
      >
        <span
          class="rh-button__content"
        >
          <svg
            aria-hidden="true"
            class="lucide lucide-circle-check rh-icon"
            data-icon="circle-check"
            fill="none"
            focusable="false"
            height="14"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="14"
            xmlns="http://www.w3.org/2000/svg"
          >
            <circle
              cx="12"
              cy="12"
              r="10"
            />
            <path
              d="m16 9-5.5 5.5L8 12"
            />
          </svg>
          <span
            class="rh-button__label"
          >
            Accept
          </span>
        </span>
      </button>
      <button
        aria-describedby="rh-review-decision-ID-qualify"
        class="rh-button rh-button--secondary rh-button--sm"
        data-decision="qualify"
        data-variant="secondary"
        type="button"
      >
        <span
          class="rh-button__content"
        >
          <svg
            aria-hidden="true"
            class="lucide lucide-info rh-icon"
            data-icon="info"
            fill="none"
            focusable="false"
            height="14"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
