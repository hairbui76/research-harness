          >
            <circle
              cx="12"
              cy="12"
              r="10"
            />
            <path
              d="m15 9-6 6"
            />
            <path
              d="m9 9 6 6"
            />
          </svg>
          <span
            class="rh-button__label"
          >
            Reject
          </span>
        </span>
      </button>
      <button
        aria-describedby="rh-review-decision-ID-defer"
        class="rh-button rh-button--ghost rh-button--sm"
        data-decision="defer"
        data-variant="ghost"
        type="button"
      >
        <span
          class="rh-button__content"
        >
          <svg
            aria-hidden="true"
            class="lucide lucide-clock rh-icon"
            data-icon="clock"
            fill="none"
            focusable="false"
            height="14"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="14"
            xmlns="http://www.w3.org/2000/svg"
          >
            <circle
              cx="12"
              cy="12"
              r="10"
            />
            <path
              d="M12 6v6l4 2"
            />
          </svg>
          <span
            class="rh-button__label"
          >
            Defer
          </span>
        </span>
      </button>
      <button
        aria-describedby="rh-review-decision-rp-ID_more_evidence"
        class="rh-button rh-button--secondary rh-button--sm"
        data-decision="request_more_evidence"
        data-variant="secondary"
        type="button"
      >
        <span
          class="rh-button__content"
        >
          <svg
            aria-hidden="true"
            class="lucide lucide-search rh-icon"
            data-icon="search"
            fill="none"
            focusable="false"
            height="14"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="14"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="m21 21-4.34-4.34"
            />
            <circle
              cx="11"
              cy="11"
              r="8"
            />
          </svg>
          <span
            class="rh-button__label"
          >
            Request more evidence
          </span>
        </span>
      </button>
    </div>
    <p
      aria-hidden="true"
      class="rh-review-decision-bar__hint"
      data-testid="rh-review-decision-hint"
    />
    <div
      class="rh-visually-hidden"
    >
      <span
        id="rh-review-decision-ID-accept"
      >
        Add this to the project’s accepted scientific state.
      </span>
      <span
        id="rh-review-decision-ID-qualify"
      >
        Accept it with a stated condition or scope limit.
      </span>
      <span
        id="rh-review-decision-ID-edit"
      >
        Change the wording before deciding.
      </span>
      <span
        id="rh-review-decision-rp-ID"
      >
        Record that this was considered and not accepted.
      </span>
      <span
        id="rh-review-decision-ID-defer"
      >
        Leave it in the queue for later.
      </span>
      <span
        id="rh-review-decision-rp-ID_more_evidence"
      >
        Send it back for a stronger source before deciding.
      </span>
    </div>
  </div>
</div>
`;

