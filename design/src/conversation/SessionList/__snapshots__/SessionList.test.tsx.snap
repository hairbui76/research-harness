                d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"
              />
            </svg>
          </button>
        </div>
      </li>
      <li>
        <div
          class="rh-session-list__row"
        >
          <button
            class="rh-session-list__select"
            type="button"
          >
            <span
              class="rh-session-list__title"
            >
              Grant notes
            </span>
            <span
