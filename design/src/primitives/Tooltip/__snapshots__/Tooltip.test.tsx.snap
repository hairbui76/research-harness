// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Tooltip > Tooltip theme x density > matches the dark / comfortable snapshot 1`] = `
<div
  data-rh-portal="tooltip"
>
  <div
    class="rh-tooltip"
    data-placement="bottom"
    id="rh-tooltip-ID"
    role="tooltip"
    style="position: fixed; top: 8px; left: 8px;"
  >
    Runs the retrieval step again
  </div>
</div>
`;

