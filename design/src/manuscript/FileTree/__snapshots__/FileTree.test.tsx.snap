        />
      </svg>
      <span
        class="rh-file-tree__name"
      >
        manuscript
      </span>
      <span
        class="rh-visually-hidden"
      >
        Folder
      </span>
    </div>
    <div
      aria-level="2"
      aria-posinset="1"
      aria-selected="true"
      aria-setsize="3"
      class="rh-file-tree__row is-selected"
      data-kind="tex"
