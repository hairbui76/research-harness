      aria-label="Scientific audit"
      class="rh-audit-finding-list__rows"
    >
      <li
        class="rh-audit-finding"
        data-kind="unregistered_claim"
        data-severity="error"
        data-source="audit"
      >
        <blockquote
          class="rh-audit-finding__sentence"
        >
          The pretrained encoder improves F1 by 2.57 points over the strongest baseline.
        </blockquote>
        <p
          class="rh-audit-finding__found"
        >
          <span
            class="rh-audit-finding__kind"
          >
            Unregistered claim
          </span>
           — 
          <span
            class="rh-audit-finding__message"
          >
            the sentence states 2.57 points; anchor it to a Claim so the manuscript stays downstream of accepted state
          </span>
        </p>
        <div
          class="rh-audit-finding__foot"
        >
          <span
            class="rh-described-term rh-audit-finding__severity"
          >
