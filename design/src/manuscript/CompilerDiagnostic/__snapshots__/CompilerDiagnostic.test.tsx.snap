          />
          <path
            d="m14 12.5 2 2.5-2 2.5"
          />
        </svg>
        <span>
          manuscript/refs.bib
        </span>
        <span
          class="rh-diagnostic-list__count"
        >
          1
        </span>
      </h4>
      <ul
        aria-label="Compiler diagnostics: manuscript/refs.bib"
        class="rh-diagnostic-list__rows"
      >
        <li
          class="rh-diagnostic"
