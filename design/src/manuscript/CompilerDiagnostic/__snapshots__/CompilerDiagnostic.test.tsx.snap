              focusable="false"
              height="16"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              width="16"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"
              />
              <path
                d="M12 9v4"
              />
              <path
                d="M12 17h.01"
              />
            </svg>
            <span
              class="rh-diagnostic__severity"
            >
              Warning
            </span>
            <span
              class="rh-diagnostic__message"
            >
              Overfull \\hbox (12.4pt too wide).
            </span>
            <span
              class="rh-diagnostic__position"
            >
              line 210
            </span>
          </button>
        </li>
      </ul>
    </div>
    <div
      class="rh-diagnostic-list__group"
    >
      <h4
        class="rh-diagnostic-list__file"
      >
        <svg
          aria-hidden="true"
