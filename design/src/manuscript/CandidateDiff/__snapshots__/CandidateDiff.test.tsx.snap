                  d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"
                />
              </svg>
              protected: citation
            </span>
          </div>
        </div>
      </section>
    </div>
    <footer
      class="rh-candidate-diff__footer"
    >
      <button
        class="rh-button rh-button--primary rh-button--sm"
        data-variant="primary"
        type="button"
      >
        <span
          class="rh-button__content"
        >
          <svg
            aria-hidden="true"
            class="lucide lucide-check rh-icon"
            data-icon="check"
            fill="none"
            focusable="false"
            height="14"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="14"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M20 6 9 17l-5-5"
            />
          </svg>
          <span
            class="rh-button__label"
          >
            Apply to source
          </span>
        </span>
      </button>
      <button
        class="rh-button rh-button--secondary rh-button--sm"
        data-variant="secondary"
        type="button"
      >
        <span
          class="rh-button__content"
        >
          <svg
            aria-hidden="true"
            class="lucide lucide-x rh-icon"
            data-icon="x"
            fill="none"
            focusable="false"
            height="14"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="14"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M18 6 6 18"
            />
            <path
              d="m6 6 12 12"
            />
          </svg>
          <span
            class="rh-button__label"
          >
            Reject
          </span>
        </span>
      </button>
      <p
        class="rh-candidate-diff__blocked"
        data-tone="neutral"
      >
        <svg
          aria-hidden="true"
          class="lucide lucide-info rh-icon"
          data-icon="info"
          fill="none"
          focusable="false"
          height="14"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="14"
          xmlns="http://www.w3.org/2000/svg"
        >
          <circle
            cx="12"
            cy="12"
            r="10"
          />
          <path
            d="M12 16v-4"
          />
          <path
            d="M12 8h.01"
          />
        </svg>
        <span>
          Applying writes the file. Nothing is written until you click Apply.
        </span>
      </p>
    </footer>
  </article>
</div>
`;
