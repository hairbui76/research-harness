          >
            <circle
              cx="11"
              cy="11"
              r="8"
            />
            <line
              x1="21"
              x2="16.65"
              y1="21"
              y2="16.65"
            />
            <line
              x1="8"
              x2="14"
              y1="11"
              y2="11"
            />
          </svg>
        </button>
        <p
          class="rh-pdf-preview__scale"
        >
          100
          %
        </p>
        <button
          aria-label="Zoom in"
          class="rh-icon-button rh-icon-button--sm rh-button--ghost"
          data-variant="ghost"
          type="button"
        >
          <svg
            aria-hidden="true"
            class="lucide lucide-zoom-in rh-icon"
            data-icon="zoom-in"
            fill="none"
            focusable="false"
            height="14"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="14"
