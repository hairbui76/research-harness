// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ProjectRail grouped theme x density > matches the dark / comfortable snapshot 1`] = `
<div
  data-density="comfortable"
  data-theme="dark"
>
  <nav
    aria-label="Project navigation"
    class="rh-project-rail"
    id="rh-projectrail-ID"
  >
    <div
      class="rh-project-rail__head"
    >
      <p
        class="rh-project-rail__project"
        title="/home/r/thermal"
      >
        <svg
          aria-hidden="true"
          class="lucide lucide-folder rh-icon"
          data-icon="folder"
          fill="none"
          focusable="false"
          height="16"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="16"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"
          />
        </svg>
        <span
          class="rh-project-rail__project-name"
