exports[`ProjectRail multi-project theme x density > matches the dark / comfortable snapshot 1`] = `
<div
  data-density="comfortable"
  data-theme="dark"
>
  <nav
    aria-label="Project navigation"
    class="rh-project-rail"
    id="rh-projectrail-ID"
  >
    <div
      class="rh-project-rail__head"
    >
      <button
        aria-expanded="false"
        aria-haspopup="menu"
        aria-label="Project: Thermal tolerance. 2 active. Switch project"
        class="rh-project-rail__project"
        data-state="closed"
        id="rh-menu-ID-trigger"
        type="button"
      >
        <svg
          aria-hidden="true"
          class="lucide lucide-folder rh-icon"
          data-icon="folder"
          fill="none"
          focusable="false"
          height="16"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="16"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"
          />
        </svg>
        <span
          class="rh-project-rail__project-name"
        >
          Thermal tolerance
        </span>
        <span
          class="rh-project-rail__project-state"
          data-tone="neutral"
        >
          2 active
        </span>
        <svg
          aria-hidden="true"
          class="lucide lucide-chevron-down rh-icon"
          data-icon="chevron-down"
          fill="none"
          focusable="false"
          height="14"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="14"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="m6 9 6 6 6-6"
          />
        </svg>
      </button>
      <button
        aria-expanded="false"
        aria-haspopup="menu"
        aria-label="Project actions"
        class="rh-icon-button rh-icon-button--sm rh-button--ghost rh-project-rail__head-control"
        data-state="closed"
        data-variant="ghost"
        id="rh-menu-ID-trigger"
        type="button"
      >
        <svg
          aria-hidden="true"
          class="lucide lucide-ellipsis rh-icon"
          data-icon="more-horizontal"
          fill="none"
          focusable="false"
          height="14"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="14"
          xmlns="http://www.w3.org/2000/svg"
        >
          <circle
            cx="12"
            cy="12"
            r="1"
          />
          <circle
            cx="19"
            cy="12"
            r="1"
          />
          <circle
            cx="5"
            cy="12"
            r="1"
          />
        </svg>
      </button>
      <button
        aria-expanded="true"
        aria-label="Collapse the rail"
        class="rh-icon-button rh-icon-button--sm rh-button--ghost rh-project-rail__collapse"
        data-variant="ghost"
        type="button"
      >
        <svg
          aria-hidden="true"
          class="lucide lucide-panel-left rh-icon"
          data-icon="panel-left"
          fill="none"
          focusable="false"
          height="14"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="14"
          xmlns="http://www.w3.org/2000/svg"
        >
          <rect
            height="18"
            rx="2"
            width="18"
            x="3"
            y="3"
          />
          <path
            d="M9 3v18"
          />
        </svg>
      </button>
    </div>
    <div
      class="rh-project-rail__new"
    >
      <button
        class="rh-button rh-button--primary rh-button--sm rh-button--full"
        data-variant="primary"
        type="button"
      >
        <span
          class="rh-button__content"
        >
          <svg
            aria-hidden="true"
            class="lucide lucide-plus rh-icon"
            data-icon="plus"
            fill="none"
            focusable="false"
            height="14"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="14"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M5 12h14"
            />
            <path
              d="M12 5v14"
            />
          </svg>
          <span
            class="rh-button__label"
          >
            New session
          </span>
        </span>
      </button>
    </div>
    <ul
      aria-label="Research"
      class="rh-project-rail__nav"
    >
      <li>
        <a
          class="rh-project-rail__nav-item"
          href="/corpus"
        >
          <svg
            aria-hidden="true"
            class="lucide lucide-library rh-icon"
            data-icon="library"
            fill="none"
            focusable="false"
            height="16"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="16"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="m16 6 4 14"
            />
            <path
              d="M12 6v14"
            />
            <path
              d="M8 8v12"
            />
            <path
              d="M4 4v16"
            />
          </svg>
          <span
            class="rh-project-rail__nav-label"
          >
            Corpus
          </span>
        </a>
      </li>
      <li>
        <a
          aria-current="page"
          class="rh-project-rail__nav-item"
          data-active=""
          href="/claims"
        >
          <svg
            aria-hidden="true"
            class="lucide lucide-bookmark rh-icon"
            data-icon="bookmark"
            fill="none"
            focusable="false"
            height="16"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="16"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M17 3a2 2 0 0 1 2 2v15a1 1 0 0 1-1.496.868l-4.512-2.578a2 2 0 0 0-1.984 0l-4.512 2.578A1 1 0 0 1 5 20V5a2 2 0 0 1 2-2z"
            />
          </svg>
          <span
            class="rh-project-rail__nav-label"
          >
            Claims
          </span>
        </a>
      </li>
      <li>
        <button
          class="rh-project-rail__nav-item"
          type="button"
        >
          <svg
            aria-hidden="true"
            class="lucide lucide-inbox rh-icon"
            data-icon="inbox"
            fill="none"
            focusable="false"
            height="16"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="16"
            xmlns="http://www.w3.org/2000/svg"
          >
            <polyline
              points="22 12 16 12 14 15 10 15 8 12 2 12"
            />
            <path
              d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"
            />
          </svg>
          <span
            class="rh-project-rail__nav-label"
          >
            Review inbox
          </span>
          <span
            class="rh-project-rail__nav-count"
          >
            4
            <span
              class="rh-visually-hidden"
            >
               Review inbox items
            </span>
          </span>
        </button>
      </li>
    </ul>
    <div
      class="rh-project-rail__foot"
    >
      <p
        class="rh-project-rail__provider"
        data-tone="success"
      >
        <svg
          aria-hidden="true"
          class="lucide lucide-circle-check rh-icon"
          data-icon="circle-check"
          fill="none"
          focusable="false"
          height="14"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="14"
          xmlns="http://www.w3.org/2000/svg"
        >
          <circle
            cx="12"
            cy="12"
            r="10"
          />
          <path
            d="m16 9-5.5 5.5L8 12"
          />
        </svg>
        <span>
          <span
            class="rh-project-rail__provider-name"
          >
            Local Ollama
          </span>
          <span
            class="rh-project-rail__provider-state"
          >
            Ready
          </span>
        </span>
      </p>
      <button
        class="rh-button rh-button--ghost rh-button--sm"
        data-variant="ghost"
        type="button"
      >
        <span
          class="rh-button__content"
        >
          <svg
            aria-hidden="true"
            class="lucide lucide-settings rh-icon"
            data-icon="settings"
            fill="none"
            focusable="false"
            height="14"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="14"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915"
            />
            <circle
              cx="12"
              cy="12"
              r="3"
            />
          </svg>
          <span
            class="rh-button__label"
          >
            Settings
          </span>
        </span>
      </button>
    </div>
  </nav>
</div>
