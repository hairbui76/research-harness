{
  "name": "@research-harness/design",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Research Harness Design System: semantic tokens, dark/light themes, accessible primitives, and research/conversation/manuscript presentation components. Presentation only - no daemon calls, no research state.",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css",
    "./tokens/*": "./src/tokens/*",
    "./themes/*": "./src/themes/*"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/check-tokens.mjs && node scripts/check-contrast.mjs",
    "specimens": "vite specimens"
  },
  "peerDependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "dependencies": {
    "lucide-react": "1.39.0"
  },
  "devDependencies": {
    "@eslint/js": "9.37.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "axe-core": "4.13.0",
    "eslint": "9.37.0",
    "globals": "^17.12.0",
    "jsdom": "25.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0",
    "vite": "5.4.20",
    "vitest": "2.1.9"
  }
}
