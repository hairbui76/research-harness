        "Results",
        "Latency"
      ],
      "text": "5.2  Tail latency under batching"
    },
    {
      "bbox": [
        54.0,
        98.69,
        477.2,
        124.4
      ],
      "id": "B0081",
      "kind": "paragraph",
      "order": 6,
      "page": 6,
      "section_path": [
        "Results",
        "Latency"
      ],
      "text": "Across the corpus, enabling batching lowered p99 latency by nine percent (from 412 ms to 375 ms) with no change in median latency."
    },
    {
      "bbox": [
        54.0,
        99.69,
        477.2,
        125.4
      ],
      "id": "B0082",
      "kind": "paragraph",
      "order": 7,
      "page": 6,
      "section_path": [
        "Results",
        "Latency"
      ],
      "text": "The effect was smaller on the eight-node cluster, where p99 moved by under one percent."
    }
  ],
