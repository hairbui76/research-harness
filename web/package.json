{
  "name": "research-harness-web",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "The Research Harness cockpit: a local-first research workstation UI over the daemon's named capabilities.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "gen:types": "node scripts/gen-types.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "4.10.38",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.1"
  },
  "devDependencies": {
    "@eslint/js": "9.37.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.18.8",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.37.0",
    "globals": "^17.12.0",
    "jsdom": "25.0.1",
    "openapi-typescript": "7.9.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0",
    "vite": "5.4.20",
    "vitest": "2.1.9"
  }
}
