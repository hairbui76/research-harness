  "info": {
    "summary": "Named capabilities over one local research workspace (Product 22).",
    "title": "Research Harness daemon",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/artifacts/{artifact_id}/bytes": {
      "get": {
        "description": "The immutable bytes an evidence anchor was accepted against (Product 42 D).\n\nRead-only and byte-identical: there is no counterpart that writes an artifact,\nbecause an artifact is registered once and never edited (ADR-002).",
        "operationId": "artifact_bytes_artifacts__artifact_id__bytes_get",
        "parameters": [
          {
            "in": "path",
            "name": "artifact_id",
            "required": true,
            "schema": {
              "title": "Artifact Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Artifact Bytes"
      }
    },
    "/blocks/{artifact_id}": {
      "get": {
        "description": "The stored parse of one artifact: page, order, and geometry for each block.\n\nThis is what lets a source pane draw the evidence span on the page without\nre-parsing the PDF, which is why the blocks are canonical (Product 8.1).",
        "operationId": "blocks_blocks__artifact_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "artifact_id",
            "required": true,
            "schema": {
              "title": "Artifact Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtifactBlocks"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Blocks"
      }
    },
    "/candidates/{candidate_id}": {
      "get": {
        "description": "One staged candidate, verbatim, so a review action can post the object back.\n\nStaging is a proposal store with no authority (ADR-003): reading it changes nothing,\nand accepting what it holds still goes through `evidence.accept`.",
        "operationId": "candidate_candidates__candidate_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "candidate_id",
            "required": true,
            "schema": {
              "title": "Candidate Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CandidateView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Candidate"
      }
    },
    "/capabilities": {
      "get": {
        "description": "Every named capability with its permission and both JSON schemas.",
        "operationId": "capabilities_capabilities_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilityCatalog"
                }
              }
