        "summary": "Overview"
      }
    },
    "/runs/{run_id}": {
      "get": {
        "description": "The durable record of one long-running workflow.",
        "operationId": "run_runs__run_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          }
